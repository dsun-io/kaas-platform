{
  "quotation": {
    "name_zh": "报价单",
    "name_en": "Quotation",
    "description": "向客户提供产品报价,包含价格、付款方式、有效期等",
    "template_file": "quotation.html",
    "fields": {
      "seller": {
        "type": "object",
        "required": true,
        "description": "卖方信息(公司名称、地址、电话、邮箱)"
      },
      "buyer": {
        "type": "object",
        "required": true,
        "description": "买方信息(公司名称、地址、联系人)"
      },
      "quote_no": {
        "type": "string",
        "required": true,
        "description": "报价单号"
      },
      "quote_date": {
        "type": "date",
        "required": true,
        "description": "报价日期"
      },
      "valid_until": {
        "type": "date",
        "required": false,
        "description": "有效期至"
      },
      "currency": {
        "type": "string",
        "required": true,
        "description": "币种(USD/CNY等)"
      },
      "items": {
        "type": "array",
        "required": true,
        "description": "商品明细(品名、规格、HS编码、数量、单价、金额)"
      },
      "total_amount": {
        "type": "number",
        "required": true,
        "description": "总金额"
      },
      "payment_terms": {
        "type": "string",
        "required": false,
        "description": "付款方式(如 T/T 30% 定金)"
      },
      "delivery_time": {
        "type": "string",
        "required": false,
        "description": "交货期"
      },
      "incoterm": {
        "type": "string",
        "required": false,
        "description": "贸易术语(FOB/CIF/EXW等)"
      },
      "port_of_loading": {
        "type": "string",
        "required": false,
        "description": "装运港"
      },
      "port_of_destination": {
        "type": "string",
        "required": false,
        "description": "目的港"
      },
      "remarks": {
        "type": "string",
        "required": false,
        "description": "备注"
      },
      "country_of_origin": {
        "type": "string",
        "required": false,
        "description": "原产国（如 China）"
      }
    }
  },
  "pi": {
    "name_zh": "形式发票",
    "name_en": "Proforma Invoice",
    "description": "预开发票,用于客户确认订单、申请进口许可、开立信用证",
    "template_file": "pi.html",
    "fields": {
      "seller": {
        "type": "object",
        "required": true,
        "description": "卖方信息"
      },
      "buyer": {
        "type": "object",
        "required": true,
        "description": "买方信息"
      },
      "pi_no": {
        "type": "string",
        "required": true,
        "description": "PI 编号"
      },
      "pi_date": {
        "type": "date",
        "required": true,
        "description": "PI 日期"
      },
      "currency": {
        "type": "string",
        "required": true,
        "description": "币种"
      },
      "items": {
        "type": "array",
        "required": true,
        "description": "商品明细(品名、规格、HS编码、数量、单位、单价、金额)"
      },
      "total_amount": {
        "type": "number",
        "required": true,
        "description": "总金额"
      },
      "payment_terms": {
        "type": "string",
        "required": true,
        "description": "付款方式"
      },
      "delivery_time": {
        "type": "string",
        "required": false,
        "description": "交货期"
      },
      "incoterm": {
        "type": "string",
        "required": true,
        "description": "贸易术语"
      },
      "port_of_loading": {
        "type": "string",
        "required": false,
        "description": "装运港"
      },
      "port_of_destination": {
        "type": "string",
        "required": false,
        "description": "目的港"
      },
      "bank_info": {
        "type": "object",
        "required": false,
        "description": "收款银行信息(开户行、账号、SWIFT)"
      },
      "company_stamp": {
        "type": "image",
        "required": false,
        "description": "公司公章/签章图片(data URI 或 https 地址),叠印在签章区"
      },
      "product_photos": {
        "type": "image_list",
        "required": false,
        "description": "产品照片列表,元素为 { image: data URI|https, caption: 说明文字 };渲染在金额大写之后"
      },
      "buyer_confirmation": {
        "type": "boolean",
        "required": false,
        "description": "是否印出买方回签栏(签名+盖章+日期);true=用买方公司名,也可填自定义抬头。默认不印"
      },
      "country_of_origin": {
        "type": "string",
        "required": false,
        "description": "原产国（如 China）"
      },
      "remarks": {
        "type": "string",
        "required": false,
        "description": "备注（支持多行：换行会保留为 <br>，逐点换行）"
      },
      "shipping_marks": {
        "type": "string",
        "required": false,
        "description": "运输唛头（外包装标记，须与发票/装箱单一致）"
      },
      "fx_rate": {
        "type": "number",
        "required": false,
        "description": "汇率（1 USD = ? CNY，如 6.7029；有值才渲染双币种金额块）"
      },
      "fx_source": {
        "type": "string",
        "required": false,
        "description": "汇率来源（如 Bank of China USD spot buying rate 670.29 per USD 100）"
      },
      "fx_date": {
        "type": "string",
        "required": false,
        "description": "汇率日期（如 2026-09-28）"
      },
      "rounding_adjustment_cny": {
        "type": "number",
        "required": false,
        "description": "舍入调整 CNY（未舍入合计−舍入后合计；留空自动推导）"
      },
      "rounding_adjustment_usd": {
        "type": "number",
        "required": false,
        "description": "舍入调整 USD（留空自动推导）"
      },
      "inland_freight_cny": {
        "type": "number",
        "required": false,
        "description": "内陆运费 CNY（已含在应付总额内）"
      },
      "inland_freight_usd": {
        "type": "number",
        "required": false,
        "description": "内陆运费 USD（留空按汇率自动换算）"
      },
      "deposit_cny": {
        "type": "number",
        "required": false,
        "description": "定金 CNY（留空按付款条款百分比自动推导）"
      },
      "deposit_usd": {
        "type": "number",
        "required": false,
        "description": "定金 USD（留空自动推导）"
      },
      "balance_cny": {
        "type": "number",
        "required": false,
        "description": "尾款 CNY（留空 = 应付总额 − 定金）"
      },
      "balance_usd": {
        "type": "number",
        "required": false,
        "description": "尾款 USD（留空自动推导）"
      },
      "total_goods_value_cny": {
        "type": "number",
        "required": false,
        "description": "货物总值 CNY（不含运费；留空按未舍入合计推导）"
      },
      "total_goods_value_usd": {
        "type": "number",
        "required": false,
        "description": "货物总值 USD（留空自动推导）"
      },
      "total_payable_cny": {
        "type": "number",
        "required": false,
        "description": "应付总额 CNY（货物总值 + 内陆运费；留空自动推导）"
      },
      "total_payable_usd": {
        "type": "number",
        "required": false,
        "description": "应付总额 USD（留空自动推导）"
      },
      "fx_block": {
        "type": "string",
        "required": false,
        "description": "（渲染器派生：双币种金额块，含汇率/舍入/运费/定金尾款/应付总额，勿手填）"
      },
      "ref_quote_no": {
        "type": "string",
        "required": false,
        "description": "引用报价单号（如 LJ-Q-20260928-01；有值才在单号栏显示）"
      },
      "ref_contract_no": {
        "type": "string",
        "required": false,
        "description": "引用合同号（有值才显示）"
      },
      "valid_until": {
        "type": "date",
        "required": false,
        "description": "有效期至（PI 报价有效期）"
      },
      "packing_details": {
        "type": "string",
        "required": false,
        "description": "包装细则（多行；换行保留，有值才显示）"
      },
      "production_photos_note": {
        "type": "string",
        "required": false,
        "description": "生产进度照片说明（多行，有值才显示）"
      },
      "third_party_consolidator": {
        "type": "string",
        "required": false,
        "description": "第三方拼柜方（有值才显示）"
      },
      "signatory": {
        "type": "string",
        "required": false,
        "description": "卖方签署人（姓名/职务，有值才显示）"
      }
    }
  },
  "contract": {
