      },
      "clauses": {
        "type": "array",
        "required": false,
        "description": "中英双语条款（默认内置 12 条；按 key 覆盖，未知 key 追加；提供即启用双语块）"
      },
      "contract_clauses_block": {
        "type": "string",
        "required": false,
        "description": "（渲染器派生：合同条款块，勿手填）"
      }
    }
