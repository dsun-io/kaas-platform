{
  "name": "kaas-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "next typegen && tsc --noEmit",
    "contracts:check": "tsx ../scripts/contracts-check.ts",
    "trade-doc:check": "tsx ../scripts/check-trade-doc-placeholders.ts",
    "mocks:check": "tsx scripts/check-msw-coverage.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:export": "node scripts/build-export-e2e.mjs && playwright test --config playwright.export.config.ts",
    "e2e:export:only": "playwright test --config playwright.export.config.ts",
    "ui:contrast": "node scripts/ui-contrast-audit.cjs",
    "ui:standards": "node scripts/ui-standards-check.cjs",
    "assets:check": "node ../scripts/check-export-assets.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@sentry/nextjs": "^10.51.0",
    "@tanstack/react-query": "^5.100.8",
    "@tanstack/react-query-devtools": "^5.100.8",
    "@tanstack/react-virtual": "^3.13.24",
    "axios": "^1.18.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "exceljs": "^4.4.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.400.0",
    "next": "^16.4.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.75.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "msw": "^2.14.2",
    "postcss": "^8.5.18",
    "shadcn": "^4.6.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.134.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
