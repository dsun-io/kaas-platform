# msg-router 环境配置模板
# 复制此文件为 .env 并根据需要修改

# ========== 服务配置 ==========

# API 服务监听地址和端口
API_HOST=0.0.0.0
API_PORT=8000
# 工作进程数，生产环境可设为 CPU 核心数
API_WORKERS=1

# ========== FastGPT 配置 ==========

# FastGPT API 密钥（必需）
FASTGPT_API_KEY=your-api-key-here

# FastGPT API 地址
FASTGPT_API_BASE=https://cloud.fastgpt.cn/api

# FastGPT 调用超时（秒）
# 建议与 RPA 的 AI_HTTP_TIMEOUT_SEC 保持一致（默认10s）
# FASTGPT_TIMEOUT_SECONDS=30.0

# 工作流应用返回详细响应（可选）
FASTGPT_CHAT_DETAIL=false

# 记录 FastGPT 失败日志（调试时开启）
FASTGPT_LOG_FAILURES=true

# ========== 业务逻辑配置 ==========

# 启用意图增强（推荐开启）
CHAT_AUGMENT_ENABLED=true

# 桩模式：true=不调用FastGPT，直接返回固定回复
CHAT_STUB_MODE=false
# 更人性化的回复示例（模拟真实客服语气）：
# - 欢迎语：亲，您好呀~ 欢迎光临我们的店铺！有什么可以帮您的吗？
# - 询问需求：亲~ 请问您想了解哪款宝贝呢？我可以给您详细介绍哦 😊
# - 催单回复：好的亲~ 我们仓库正在加急处理，预计今天就能发货，请耐心等待哈~
# - 售后回复：亲亲~ 抱歉给您带来不便了，我们会尽快处理您的问题，请放心 💪
CHAT_STUB_REPLY=亲，您好呀~ 欢迎光临我们的店铺！有什么可以帮您的吗？

# ========== 数据库配置 ==========

# SQLite 数据库路径
SQLITE_PATH=data/conversations.db

# ========== 性能优化配置 ==========

# 如需支持更高并发，增加工作进程数
# API_WORKERS=4
