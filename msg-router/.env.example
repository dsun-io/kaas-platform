# FastGPT 在线版「电商售前助手」应用 API Key（在 FastGPT 应用设置中创建）
FASTGPT_API_KEY=your_fastgpt_app_api_key_here

# 可选：覆盖默认 API 根地址（默认 https://cloud.fastgpt.cn/api；勿用 api.fastgpt.cn，该名在公网 DNS 无记录）
# FASTGPT_API_BASE=https://cloud.fastgpt.cn/api

# 工作流应用若仍返回兜底话术，改为 true（会带 responseData，便于解析节点输出）
# FASTGPT_CHAT_DETAIL=true

# FastGPT 失败时是否打警告日志（含 HTTP 状态与响应片段，便于排障）
# FASTGPT_LOG_FAILURES=true

# SQLite 路径（相对 msg-router 目录；目录会自动创建）
# SQLITE_PATH=data/conversations.db
