# msg-router 环境配置模板
# 复制此文件为 .env 并根据需要修改

# ========== 服务配置 ==========

# API 服务监听地址和端口
API_HOST=0.0.0.0
API_PORT=8000
# 工作进程数，生产环境可设为 CPU 核心数
API_WORKERS=1

# ========== FastGPT 配置 ==========

# FastGPT API 密钥（必需）
FASTGPT_API_KEY=your-api-key-here

# FastGPT API 地址
FASTGPT_API_BASE=https://cloud.fastgpt.cn/api

# FastGPT 调用超时（秒）
# 建议与 RPA 的 AI_HTTP_TIMEOUT_SEC 保持一致（默认10s）
FASTGPT_TIMEOUT_SECONDS=10

# 工作流应用返回详细响应（可选）
FASTGPT_CHAT_DETAIL=false

# 记录 FastGPT 失败日志（调试时开启）
FASTGPT_LOG_FAILURES=true

# FastGPT API 请求超时时间（秒）
# FASTGPT_TIMEOUT_SECONDS=30.0

# ========== 业务逻辑配置 ==========

# 启用意图增强（推荐开启）
CHAT_AUGMENT_ENABLED=true

# 桩模式：true=不调用FastGPT，直接返回固定回复
CHAT_STUB_MODE=false
CHAT_STUB_REPLY=回复测试~

# ========== 数据库配置 ==========

# SQLite 数据库路径
SQLITE_PATH=data/conversations.db

# ========== 性能优化配置 ==========

# 如需支持更高并发，增加工作进程数
# API_WORKERS=4

# 如需降低延迟，确保 FastGPT 超时 < RPA 超时
# FASTGPT_TIMEOUT_SECONDS=8
