# 消息路由（msg-router）基址，不要末尾斜杠
MSG_ROUTER_URL=http://localhost:8000

# 可选：若 msg-router 将来要求鉴权，填 Bearer Token；留空则不传 Authorization
MSG_ROUTER_API_KEY=

# 千牛主窗口标题需包含的子串（按你本机窗口标题调整，如：千牛、工作台、接待）
QIANNIU_WINDOW_SUBSTRING=千牛

# 定位主窗口失败时的重试
WINDOW_LOCATE_RETRIES=15
WINDOW_LOCATE_INTERVAL_SEC=2.0

# 主循环轮询间隔（秒）
POLL_INTERVAL_SEC=2.0

# 操作随机延迟（毫秒），模拟人工
ACTION_DELAY_MS_MIN=200
ACTION_DELAY_MS_MAX=500

# 调用消息路由超时（秒）
AI_HTTP_TIMEOUT_SEC=15.0

# 会话 ID 与去重持久化目录
STATE_DIR=data

# 日志目录
LOG_DIR=logs

# UI 选择器 JSON（窗口标题、未读标记、发送按钮等），相对 rpa-qianniu 根目录
# SELECTORS_PATH=config/selectors.json

# ---------- 纯视觉分区（与 smoke_vision_regions 标定一致）----------
VISION_LEFT_START_RATIO=0.07
VISION_LEFT_END_RATIO=0.15
VISION_CHAT_END_RATIO=0.56
VISION_MESSAGE_TOP_RATIO=0.15
VISION_INPUT_BOTTOM_RATIO=0.13
VISION_DEBUG_SCREENSHOTS=true
VISION_DEBUG_DIR=debug
USE_VISION_PIPELINE=false
LEGACY_UIA_PIPELINE=true
# 桩模式：固定回复内容便于测试观察
AI_STUB_REPLY=【测试回复】这是修复后的测试消息~
# 手机端来信常无左侧红点：保持本会话打开时仍轮询 message_area
FALLBACK_OPEN_CHAT_WITHOUT_UNREAD=true
