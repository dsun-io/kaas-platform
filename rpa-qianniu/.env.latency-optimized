# 千牛RPA 延迟优化配置 - 目标端到端 <5s
# 使用方式: 复制到 .env 或选择性覆盖

# ========== 核心延迟优化参数 ==========

# 会话切换后等待时间（秒）：点击待回复后等待千牛 CEF 渲染完成
# 优化值: 0.8s（默认1.5s）
VISION_SESSION_SWITCH_WAIT_SEC=0.8

# 截图后稳定时间（秒）
# 优化值: 0.05s（默认0.12s）
VISION_CAPTURE_SETTLE_SEC=0.05

# 激活轮询间隔（秒）：有未读/已处理一轮后的休眠
# 优化值: 0.3s（默认1.0s）
VISION_POLL_ACTIVE_SEC=0.3

# 人工延迟范围（毫秒）：模拟人类操作间隔
# 优化值: 50-150ms（默认200-500ms）
ACTION_DELAY_MS_MIN=50
ACTION_DELAY_MS_MAX=150

# AI 调用超时（秒）
# 优化值: 10s（默认15s）
AI_HTTP_TIMEOUT_SEC=10

# ========== 可选进一步优化 ==========

# 关闭发送后验证以节省延迟（如不需要）
# SEND_VERIFY_ENABLED=false
# SEND_VERIFY_WAIT_SEC=0.5

# 会话冷却时间（秒）：同一买家成功回复后多少秒内不再处理
# 如需快速响应同一买家，可降低至 15s（默认30s）
# VISION_SESSION_COOLDOWN_SEC=15

# 调试截图级别（0=按需/异常时；1=关键事件；2=全量）
# 建议保持0以减少IO延迟
# RPA_DEBUG_LEVEL=0

# 未读检测后整窗调试截图最小间隔（秒）
# 建议保持较大值以减少IO
# VISION_DEBUG_FULL_WINDOW_INTERVAL_SEC=60.0
