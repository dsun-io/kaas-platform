# true（默认）：不调 FastGPT，固定回复下面一句，只测千牛发消息；千牛稳定后改为 false 再走真实 AI
AI_STUB_MODE=true
AI_STUB_REPLY=回复测试~

# 消息路由（msg-router）基址，不要末尾斜杠
MSG_ROUTER_URL=http://localhost:8000

# 可选：若 msg-router 将来要求鉴权，填 Bearer Token；留空则不传 Authorization
MSG_ROUTER_API_KEY=

# 千牛主窗口标题需包含的子串（按你本机窗口标题调整，如：千牛、工作台、接待）
QIANNIU_WINDOW_SUBSTRING=千牛

# 纯视觉流水线（CEF 内无 UIA）：截图+OCR+坐标点击；需 PaddleOCR
USE_VISION_PIPELINE=true
# 设为 true 时走旧版 UIA 混合逻辑（仅当控件树可用）
LEGACY_UIA_PIPELINE=false

# 窗口水平比例（0~1）：图标栏右缘 | 会话列表右缘 | 聊天列右缘 | 余下为右侧商品区
# 红点检测只裁剪 [LEFT_START, LEFT_END)，不含左侧图标栏，避免 99+ 角标误判
VISION_LEFT_START_RATIO=0.07
VISION_LEFT_END_RATIO=0.15
VISION_CHAT_END_RATIO=0.56
# 聊天列内：顶部去掉（买家标题栏等）、底部输入+发送条
VISION_MESSAGE_TOP_RATIO=0.15
VISION_INPUT_BOTTOM_RATIO=0.13
VISION_DEBUG_SCREENSHOTS=true
VISION_DEBUG_DIR=debug

# 定位主窗口失败时的重试
WINDOW_LOCATE_RETRIES=15
WINDOW_LOCATE_INTERVAL_SEC=2.0
# 为 true 时不过滤 IsEnabled（最小化/后台时部分窗口 UIA 会报未启用）
WINDOW_LOCATE_SKIP_ENABLED_FILTER=false

# 主循环轮询间隔（秒），实际睡眠不低于 3 秒以防空转
POLL_INTERVAL_SEC=3.0

# 左侧无未读时是否仍读「当前已打开会话」的聊天区（易把历史气泡当新消息；默认 false）
FALLBACK_OPEN_CHAT_WITHOUT_UNREAD=false
# 无未读时的休眠秒数（建议 >=3）
WAIT_NO_UNREAD_POLL_SEC=4.0
# 开启兜底时：同一消息指纹在界面停留超过该秒数则不再触发 AI
FALLBACK_STALE_FINGERPRINT_SEC=30.0

# 输入框全策略失败时保存整窗截图到该目录（需 REPLY_DEBUG_SCREENSHOTS=true）
REPLY_DEBUG_SCREENSHOTS=false
REPLY_DEBUG_DIR=debug

# 未读检测调试：启动时遍历左侧会话子树，写入 debug/{时间戳}_unread_probe.log 与左侧条带 PNG
DEBUG_UNREAD_PROBE=false
DEBUG_PROBE_DIR=debug

# 左侧会话列表：对头像红点、「N秒」红条做截图识别（UIA 无未读节点时仍可用）
VISION_UNREAD_ENABLED=true

# 中间聊天列：PaddleOCR 锚定「发送」算包围盒（默认 false：不少 Windows 环境 Paddle 3.x 推理会崩）
CHAT_OCR_ENABLED=false
CHAT_OCR_CACHE_SEC=3.0
CHAT_DEBUG_SCREENSHOTS=false
CHAT_DEBUG_DIR=data/debug_chat

# 操作随机延迟（毫秒），模拟人工
ACTION_DELAY_MS_MIN=200
ACTION_DELAY_MS_MAX=500

# 调用消息路由超时（秒）
AI_HTTP_TIMEOUT_SEC=15.0

# 会话 ID 与去重持久化目录
STATE_DIR=data

# 日志目录
LOG_DIR=logs

# UI 选择器 JSON（窗口标题、未读标记、发送按钮等），相对 rpa-qianniu 根目录
# SELECTORS_PATH=config/selectors.json
