# 千牛RPA 环境配置模板
# 复制此文件为 .env 并根据需要修改

# ========== 核心服务配置 ==========

# msg-router 服务地址
MSG_ROUTER_URL=http://localhost:8000
MSG_ROUTER_API_KEY=

# ========== AI 配置 ==========

# AI 桩模式：true=不调用FastGPT，直接返回固定回复（调试时使用）
AI_STUB_MODE=true
AI_STUB_REPLY=回复测试~

# AI 调用超时（秒）
# 优化延迟时建议设为 10，正常使用时建议 15
AI_HTTP_TIMEOUT_SEC=10

# ========== 窗口与UI配置 ==========

# 千牛窗口标题匹配子串
QIANNIU_WINDOW_SUBSTRING=千牛

# 窗口定位重试次数
WINDOW_LOCATE_RETRIES=15
WINDOW_LOCATE_INTERVAL_SEC=2.0

# 左侧列表无未读时的轮询间隔（秒）
POLL_INTERVAL_SEC=3.0
WAIT_NO_UNREAD_POLL_SEC=4.0

# ========== 纯视觉流水线配置 ==========

# 启用纯视觉流水线（截图+OCR+pyautogui）
USE_VISION_PIPELINE=true
LEGACY_UIA_PIPELINE=false

# 激活轮询间隔（秒）：有未读/已处理一轮后的休眠
# 延迟优化建议: 0.3s（快速响应）
# 稳定运行建议: 1.0s（默认）
VISION_POLL_ACTIVE_SEC=0.3

# 会话切换后等待时间（秒）：点击待回复后等待渲染
# 延迟优化建议: 0.8s
# 稳定运行建议: 1.5s
VISION_SESSION_SWITCH_WAIT_SEC=0.8

# 截图后稳定时间（秒）
# 延迟优化建议: 0.05s
VISION_CAPTURE_SETTLE_SEC=0.05

# 会话冷却时间（秒）：同一买家成功回复后冷却
VISION_SESSION_COOLDOWN_SEC=30.0

# 消息区域顶部横幅跳过像素（避免OCR噪声）
MSG_BANNER_SKIP_PX=120

# ========== 调试配置 ==========

# 调试级别：0=按需/异常；1=关键事件；2=全量
RPA_DEBUG_LEVEL=0

# 是否保存调试截图
VISION_DEBUG_SCREENSHOTS=false
VISION_DEBUG_DIR=debug

# 未读探针调试
DEBUG_UNREAD_PROBE=false

# 控制台输出同步到日志文件
LOG_CONSOLE_TEE=true
LOG_DIR=logs

# ========== 性能优化配置（延迟<5s目标） ==========
# 如需优化到<5s端到端延迟，覆盖以下参数：

# ACTION_DELAY_MS_MIN=50
# ACTION_DELAY_MS_MAX=150
# VISION_POLL_ACTIVE_SEC=0.3
# VISION_SESSION_SWITCH_WAIT_SEC=0.8
# VISION_CAPTURE_SETTLE_SEC=0.05
# AI_HTTP_TIMEOUT_SEC=10

# 或复制 .env.latency-optimized 的内容到 .env

# ========== 高级配置（通常无需修改） ==========

# 操作延迟最小值（毫秒）：pyautogui 操作之间的最小延迟
# 默认: 50
ACTION_DELAY_MS_MIN=50

# 操作延迟最大值（毫秒）：pyautogui 操作之间的最大延迟
# 默认: 150
ACTION_DELAY_MS_MAX=150

# 窗口定位过滤器配置
# WINDOW_LOCATE_SKIP_ENABLED_FILTER=true

# 兜底轮询配置
# FALLBACK_OPEN_CHAT_WITHOUT_UNREAD=true
# FALLBACK_STALE_FINGERPRINT_SEC=30.0

# 回复调试配置
# REPLY_DEBUG_SCREENSHOTS=false
# REPLY_DEBUG_DIR=debug/reply
# DEBUG_PROBE_DIR=debug/probe

# 视觉功能开关
# VISION_UNREAD_ENABLED=true
# CHAT_OCR_ENABLED=true
# CHAT_OCR_CACHE_SEC=60
# CHAT_DEBUG_SCREENSHOTS=false
# CHAT_DEBUG_DIR=debug/chat

# 视觉区域比例配置
# VISION_LEFT_START_RATIO=0.07
# VISION_LEFT_END_RATIO=0.15
# VISION_CHAT_END_RATIO=0.56
# VISION_MESSAGE_TOP_RATIO=0.15
# VISION_INPUT_BOTTOM_RATIO=0.13

# 校准参数配置
# VISION_CALIBRATION_PATH=config/vision_calibration.json
# VISION_AUTO_CALIBRATE=true
# VISION_LEFT_PANEL_UNREAD_TOP_SKIP_PX=100
# VISION_RIGHT_NICK_TOP_SKIP_PX=96

# 红点检测配置
# VISION_UNREAD_DOT_AREA_MIN=40
# VISION_UNREAD_DOT_AREA_MAX=900

# 发送验证配置
# SEND_VERIFY_ENABLED=true
# SEND_VERIFY_WAIT_SEC=0.8

# 状态与选择器配置
# STATE_DIR=state
# SELECTORS_PATH=config/selectors.json
# VISION_DEBUG_FULL_WINDOW_INTERVAL_SEC=0
