# 千牛 RPA 视觉识别配置示例
# 复制本文件为 .env 并根据需要修改

# ---------- 消息区域 OCR 配置 ----------
# 消息区域顶部横幅跳过像素（默认 120）
# 千牛系统横幅 + AI 摘要条约占顶部 100-150px，可根据实际情况调整
MSG_BANNER_SKIP_PX=120

# 右栏昵称 ROI：从「顶栏下缘」起占右栏总高度比例（默认 0.30）
# 减小此值可减少无关 UI 元素干扰，提高昵称识别准确率
VISION_RIGHT_NICK_TOP_FRAC=0.30

# ---------- 视觉流水线配置 ----------
# 是否启用纯视觉流水线（默认 true）
USE_VISION_PIPELINE=true

# 是否启用旧版 UIA 混合逻辑（默认 false）
LEGACY_UIA_PIPELINE=false

# 左侧列表无未读时：是否仍轮询当前已打开会话的聊天区（默认 false）
FALLBACK_OPEN_CHAT_WITHOUT_UNREAD=false

# 纯视觉：有未读/已处理一轮后的休眠（秒），宜 <=1 以压低端到端延迟
VISION_POLL_ACTIVE_SEC=1.0

# ---------- 调试配置 ----------
# 调试截图级别：0=按需落盘（异常必存）；1=关键事件；2=全量
RPA_DEBUG_LEVEL=0

# 是否保存视觉调试图
VISION_DEBUG_SCREENSHOTS=false

# 视觉调试目录
VISION_DEBUG_DIR=debug

# ---------- AI 配置 ----------
# AI 桩模式：设为 true 可禁用 FastGPT 调用，直接返回固定回复（调 UI 时省积分）
AI_STUB_MODE=true

# AI 桩模式固定回复内容
AI_STUB_REPLY=回复测试~

# ---------- 其他配置 ----------
# 千牛窗口标题子串（用于窗口定位）
QIANNIU_WINDOW_SUBSTRING=千牛

# 窗口定位重试次数
WINDOW_LOCATE_RETRIES=15

# 轮询间隔（秒）
POLL_INTERVAL_SEC=3.0

# 无未读时的等待轮询间隔（秒），宜 >= 3
WAIT_NO_UNREAD_POLL_SEC=4.0
