# ─── Kaas v2 Backend Environment Variables ───
# Copy to .env and fill in real values. NEVER commit .env to git.

# ─── Database (PostgreSQL) ───
DATABASE_URL=postgresql+asyncpg://kaas:kaas_dev@localhost:5432/kaas_dev

# ─── Redis (L5 session memory, Phase 1 可用 Python dict 代替) ───
REDIS_URL=redis://localhost:6379/0

# ─── MinIO / OSS (L0 events archive · §3.7.4) ───
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kaas-events-archive
MINIO_SECURE=false

# ─── FastGPT (反向调用知识库检索引擎) ───
FASTGPT_BASE_URL=https://your-fastgpt-instance.com
FASTGPT_API_KEY=your-fastgpt-api-key

# ─── DeepSeek LLM (仅末端话术包装 · 铁律3) ───
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ─── Application ───
APP_ENV=development
LOG_LEVEL=DEBUG
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
