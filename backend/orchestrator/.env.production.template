# ─── KaaS Platform · 生产环境配置模板 ───
# 复制为 .env 并填入真实值。严禁提交真实 .env。

APP_ENV=production
LOG_LEVEL=INFO

# Neon PostgreSQL（asyncpg 引擎；session.py 会为 *.neon.tech 自动加 SSLContext，
# 不要在此 URL 里写 sslmode/ssl 查询参数，asyncpg 会报错）
DATABASE_URL=postgresql+asyncpg://neondb_owner:<PASSWORD>@<POOLER-HOST>/neondb

# CORS：前端 Pages 域名
CORS_ORIGINS='["https://kaas.powervoy.com"]'

# JWT（生产必须替换为强随机值）
JWT_SECRET=<CHANGE-ME-64-char-random>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 管理员初始化（bootstrap 完成后建议清空）
ADMIN_SETUP_TOKEN=<CHANGE-ME>

# Redis / MinIO（如生产不使用可留默认值）
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kaas-events-archive
MINIO_SECURE=false
