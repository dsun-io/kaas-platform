# ─── Kaas v2 Backend Environment Variables ───
# Copy to .env and fill in real values. NEVER commit .env to git.

# ─── Database (PostgreSQL) ───
DATABASE_URL=postgresql+asyncpg://kaas:kaas_dev@localhost:5432/kaas_dev

# ─── Test Database (pytest) ───
# 默认自动检测: Docker 内 → postgres:5432, 本机 → localhost:5432
# 显式覆盖:
#   TEST_DATABASE_URL  : 完整连接串（最高优先级）
#   TEST_DB_HOST       : 仅覆盖 host 部分（如 kaas-postgres）
# 使用 docker-compose.test.yml:
#   TEST_DATABASE_URL=postgresql+asyncpg://kaas:kaas_dev_pw@localhost:5433/kaas_v2_test
# TEST_DATABASE_URL=
# TEST_DB_HOST=

# ─── Redis (L5 session memory, Phase 1 可用 Python dict 代替) ───
REDIS_URL=redis://localhost:6379/0

# ─── MinIO / OSS (L0 events archive · §3.7.4) ───
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kaas-events-archive
MINIO_SECURE=false

# ─── LLM Provider (§13.1) ───
LLM_PROVIDER=stub                # stub|deepseek|zhipu|template
LLM_FALLBACK=template            # 备选 provider，primary 挂时降级
LLM_TIMEOUT_SECONDS=15
LLM_DEGRADE_TO_TEMPLATE=true

# DeepSeek (§13.1)
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Zhipu GLM-4 (§13.1 · fallback)
ZHIPU_API_KEY=xxx
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4

# ─── Knowledge Provider (去 FastGPT 架构 · 默认 postgres) ───
KNOWLEDGE_PROVIDER=postgres        # postgres (默认) | fastgpt
KB_PROVIDER=stub                   # stub|fastgpt (仅向后兼容)
KB_TIMEOUT_SECONDS=10

# FastGPT (可选 · 降级为 runtime adapter · 非核心依赖)
FASTGPT_ENABLED=false
FASTGPT_BASE_URL=https://your-fastgpt.example.com
FASTGPT_API_KEY_LIANJIA=fastgpt-xxx
FASTGPT_API_KEY_CLIENT_B=fastgpt-xxx

# ─── External API Retry (§13.3) ───
EXTERNAL_API_RETRY_MAX=2

# ─── Rate Limiter (§15.1) ───
RATE_LIMIT_STORAGE=memory://
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_QUOTE=20/minute

# ─── Body Size Limit (§15.2) ───
MAX_BODY_SIZE_BYTES=1048576

# ─── Application ───
APP_ENV=development
LOG_LEVEL=DEBUG
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─── Auth (AUTH-WX-R1: JWT 鉴权) ───
JWT_SECRET=kaas-dev-jwt-secret-change-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── WeChat ClawBot (AUTH-WX-R1) ───
CLAWBOT_BASE_URL=https://your-clawbot.example.com
CLAWBOT_API_KEY=your-clawbot-api-key
