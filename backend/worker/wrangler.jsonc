{
  // KaaS Python 内核 Worker：报价/单证引擎、AI/数据能力、cron 3 条（ADR-008）。
  // ⚠️ 内核不持有公网域名：kaas.powervoy.com / api.kaas.powervoy.com 归 kaas-edge（TS 门面），
  //    对外流量与静态资产均由门面伺服，内核只经 Service Binding（env.KERNEL）被调用。
  //    禁止在本文件声明 custom domain —— 部署会把域名从门面抢走（2026-10-21 切流的配置债，
  //    2026-10-22 修复；门禁 scripts/check-deploy-domains.py）。
  "name": "kaas",
  "main": "src/main.py",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["python_workers"],
  // ── Cron Triggers（orchestrator APScheduler 迁移；逻辑在 src/ws_cron.py）──
  // ⚠️ Cloudflare cron 一律按 **UTC** 解释，orchestrator 原调度是 Asia/Shanghai（UTC+8）：
  //   · "*/15 * * * *" —— replied→询盘自动扫描（原 CronTrigger(minute="*/15")，
  //     纯间隔触发，与时区无关）；生产过去靠手动 POST /api/v1/leads/scan-replied 对等。
  //   · "30 16 * * *"  —— events 每日归档（原 00:30 Asia/Shanghai = **16:30 UTC 前一日**，
  //     UTC+8 的换算：00:30 - 8h = 前一日 16:30）。归档目标日仍按 orchestrator 口径取
  //     「UTC 昨日」，不改成上海自然日（改口径要同时改 archive_target_date，见 ws_cron.py）。
  //   · "40 17 * * *"  —— 单证指纹定时对账（每日 UTC 17:40 = Asia/Shanghai 次日 01:40）：
  //     扫近 30 天签发的单据，结论 upsert 进 trade_doc_render_checks（TODO A8/A9）。
  // 这三个字符串必须与 ws_cron.CRON_SCAN_REPLIED / CRON_ARCHIVE_EVENTS /
  // CRON_RENDER_CHECK 逐字符一致（scheduled 用 controller.cron 精确匹配分派），
  // 由 tests/test_ws_cron.py 锁死。
  "triggers": {
    "crons": ["*/15 * * * *", "30 16 * * *", "40 17 * * *"]
  },
  "workers_dev": false,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6830420703984a19a99a334afff6776e"
    }
  ],
  // 文件本体（产品图 / 客户盖章回传件 / 系统出的 PDF）走**对象存储**：
  // 业务行在 Postgres（file_objects 元数据），字节在存储里，库里只存 object_key。
  // 落点优先级（ws_files.py）：
  //   ① **S3 预签名**（配好 S3_* 时）—— 与 orchestrator 同一段 SigV4 代码，
  //      浏览器可直传（字节不过 Worker），也能发短时效直链；
  //   ② R2 binding（`FILES`）—— 没配 S3 密钥时的平台直连，同样进 R2；
  //   ③ inline（写库）—— 都没配时的兜底，如实标注 storage。
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "kaas-files"
    }
  ],
  // 自动出 PDF（Cloudflare Browser Rendering）：用户要求「自动出 pdf 字节」。
  // 用 binding 调 Quick Action `pdf`（`env.BROWSER.quickAction("pdf", {html})`）出**真 PDF 字节**，
  // **不需要任何 API token**（REST 方式才需要 `Browser Run - Edit` 权限的 token）。
  // 要求 compatibility_date ≥ 2026-03-24（当前 2026-09-18 ✓）。
  // 计费：Workers Free 含 10 分钟/天、3 并发（超出 N/A，不产生费用）；
  // Workers Paid 含 10 小时/月，超出 $0.09/浏览器小时。详见 docs/TRADE_DOC_PDF_ARCHIVAL.md。
  // 不声明这个 binding 时，ws_files.py 会退到 REST token（BROWSER_RENDERING_TOKEN），
  // 两者都没有则接口如实返回 503 PDF_RENDERER_NOT_CONFIGURED（不假装成功）。
  "browser": {
    "binding": "BROWSER"
  },
  // 非机密的 S3 配置（机密只有 S3_ACCESS_KEY / S3_SECRET_KEY，用
  // `npx wrangler secret put S3_ACCESS_KEY` 与 `... S3_SECRET_KEY` 设置；
  // R2 的 S3 密钥只能在 Cloudflare dashboard 的 "Manage R2 API Tokens" 创建）。
  // 两个 secret 未设置时，上面的 ②③ 会自动接管 —— 功能不缺，只是不走直传。
  "vars": {
    "S3_ENDPOINT": "https://766f8d7eb5a7d20e272673073ec8c3fd.r2.cloudflarestorage.com",
    "S3_BUCKET": "kaas-files",
    "S3_REGION": "auto",
    "S3_PRESIGN_EXPIRES": "900"
  },
  // 内核不暴露公网域名：必须保持为空。wrangler 只对 custom_domain 路由调 publishCustomDomains，
  // 空数组 = 部署不会触碰任何域名；删掉注释/回填域名会被 scripts/check-deploy-domains.py 拦下。
  "routes": []
  // ── 2026-10-24（P3）：**内核不再挂静态资产** ──────────────────────────────
  // 前端由 kaas-edge 伺服（ADR-008 两层架构，浏览器只访问门面域名），内核没有公网域名、
  // 只经 Service Binding + cron 被调用 —— 内核上的 assets 是纯冗余，且是**事故源**：
  //   · main.py 的 Default.fetch 曾把"非 /api && 非 /health"的请求交给 env.ASSETS.fetch，
  //     于是 P2 的 /internal/engine/* RPC 被 SPA 回退成 index.html（GET）/
  //     405 空体（POST）⇒ 门面报 "engine rpc returned non-JSON body" 502；
  //   · 更坑的是：改 wrangler 的 assets.run_worker_first（数组或 true）**完全无效**，
  //     因为分流发生在 Python 入口代码里，不在资产路由层（本项目同类坑第二次）。
  // 摘掉 assets 后：内核入口一律 asgi.fetch(app)，部署体积也从 ~12.2MB 降下来，
  // 且以后新增任何内部前缀都不必再动资产配置。
}
