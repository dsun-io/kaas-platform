{
  // KaaS TS 门面（Hono）——对外唯一门面（ADR-008，kaas-edge）。
  // 铁纪律：本 Worker 只做鉴权/参数校验/协议转换，业务规则只在 Python 内核一处实现。
  // 与 backend/worker/wrangler.jsonc 的关系：绑定/vars 口径对齐；triggers 无 cron
  // （三条 cron 留在 Python 内核 worker）；生产域名由本 Worker 持有（2026-10-21 切流，
  // 内核 routes 必须为空；门禁 scripts/check-deploy-domains.py）。
  "name": "kaas-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  // 静态资产（Next 静态导出；切流后由门面伺服，替代 Python worker 的 assets 绑定）
  // 与 backend/worker/wrangler.jsonc 同口径：/_headers 的 immutable 缓存随 out/ 一起上传。
  "assets": {
    "directory": "../../frontend/out",
    // 未命中路径回退 index.html（SPA），但 /api/* 与 /health 由 Hono 先处理，不会落到这里
    "not_found_handling": "single-page-application"
  },
  "workers_dev": false,  // W4 验收通过（2026-10-21）：关闭 workers.dev 调试入口，仅保留生产自定义域名
  // 2026-10-21 W4 切流：生产自定义域名指向 TS 门面（内核不再暴露公网域名）
  "routes": [
    {
      "pattern": "kaas.powervoy.com",
      "zone_name": "powervoy.com",
      "custom_domain": true
    },
    {
      "pattern": "api.kaas.powervoy.com",
      "zone_name": "powervoy.com",
      "custom_domain": true
    }
  ],
  // Hyperdrive 复用现有实例（与 backend/worker/wrangler.jsonc 同一 id）
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6830420703984a19a99a334afff6776e"
    }
  ],
  // 文件本体（同口径：业务行在 PG，字节在 R2，库里只存 object_key）
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "kaas-files"
    }
  ],
  // Browser Rendering（单证 PDF；要求 compatibility_date >= 2026-03-24 ✓）
  "browser": {
    "binding": "BROWSER"
  },
  // Python 内核 Worker 的 Service Binding（契约见 src/kernel.ts）。
  // 2026-10-21 启用：指向内核 worker（backend/worker/wrangler.jsonc 的 name=kaas）。
  "services": [
    { "binding": "KERNEL", "service": "kaas" }
  ],
  // 非机密 S3 配置（机密 S3_ACCESS_KEY / S3_SECRET_KEY 走 secret put；
  // 值与 backend/worker/wrangler.jsonc 的 vars 逐字对齐）
  "vars": {
    "S3_ENDPOINT": "https://766f8d7eb5a7d20e272673073ec8c3fd.r2.cloudflarestorage.com",
    "S3_BUCKET": "kaas-files",
    "S3_REGION": "auto",
    "S3_PRESIGN_EXPIRES": "900",
    // ── P0 灰度开关（docs/ARCH_AUTH_DB_SPLIT_2026-10-24.md §8）──────────────
    // AUTH_DB_SPLIT=on 时，下面白名单内的**只读热路径**走门面直连 Hyperdrive；
    // 其余值/缺失 = off = 原样透传 Python 内核（一键回退，无需改代码）。
    // 白名单按路由 id 的 '.' 前缀段匹配（见 src/boot-flag.ts）。
    // 第二批（2026-10-24 16:40）：首批 4 条线上验证通过（tail 证明内核 0 调用）后放行 products.list。
    // 至此 P0 的 5 条热读全部走门面直连：页面首屏不再依赖 Python 冷启动。
    // 回退：把 AUTH_DB_SPLIT 改成 "off"（或从白名单删条目）再发版；行为即回到全透传。
    "AUTH_DB_SPLIT": "on",
    // ⚠️ 2026-10-24 17:58 第三批**再次回退**（P2 切片暂不放量）：
    //    链路已打通（RPC 改 /api/v1 前缀后返回 200 真实算价），但灰度对比发现**商业闸门缺失**：
    //    旧路径对未开通 quotes 工位的账号返回 404 WORKSTATION_NOT_SUBSCRIBED，
    //    新路径（门面供数 → 内核纯算）直接算出报价 ⇒ 绕过了「工位未开通」闸门。
    //    根因：闸门在旧路由层（export_routes.py），没有随计算入口一起搬迁。
    //    修复前不得放量；详见 docs/P2_COUPLING_ENGINE_2026-10-24.md §9。
    // 2026-10-24 18:10 复核放量：闸门已按**单一真源**修复 —— 把内部 RPC 前缀登记进
    // kaas_common/workstation/subscriptions.py 的 WORKSTATION_PATHS["quotes"]，
    // 既有全局中间件因此自动覆盖新路径（没有第二份判定）；门面新增 4xx 原样回放。
    // 2026-10-24 19:05 第四批放量：门面**工位闸门**已实现（src/workstation-gate.ts，映射与
    // kaas_common 真源同源 + 漂移机检）⇒ 可以安全放行收费工位上的直连路由：
    //   · 引擎同族 4 切片：export-quote.{verify,formulas,spec,explain}
    //   · 批次 A 六条读：inquiries.{list,detail,stage-log} / quotations.list / tax-archives.list / product-tax-rates.list
    // 2026-10-24 19:25 第五批：trade-docs/{id}/files（单条 JOIN，**有硬团队尺** _team_scope ⇒ 安全）。
    // 2026-10-24 19:35 第六批：external-docs.list（隔离已修：内核 + 门面都补了 tenant_id + 行级谓词，
    // 下载端点也在内核侧一并修好；见 P2 §8.8）。fx-rates 仍不放量（汇率是全局基线表，等产品拍板）。
    // 回退：删条目或 AUTH_DB_SPLIT=off（行为立即回到全透传）。
    "AUTH_DB_SPLIT_ROUTES": "notifications.unread-count,approvals.list,products.profile,products.media,products.list,export-quote.calculate,export-quote.verify,export-quote.formulas,export-quote.spec,export-quote.explain,inquiries.list,inquiries.detail,inquiries.stage-log,quotations.list,tax-archives.list,product-tax-rates.list,trade-docs.files,external-docs.list,trade-docs.render-data,quotes.list,quotes.detail"
  }
  // 无 triggers（门面不跑 cron）
}
