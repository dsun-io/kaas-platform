# ─── Kaas v2 .gitignore ───

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual Environment
.venv/
venv/
env/

# Environment Variables (NEVER commit secrets)
.env
.env.*
!backend/.env.example
!frontend/.env.example
backend/.env
# Wrangler 本地密钥（worker 目录的 .gitignore 也覆盖了，这里兜底根目录/其他目录）
.dev.vars
*.dev.vars

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Node (frontend)
node_modules/
.next/
# 并发安全构建目录（NEXT_DIST_DIR）：与 `next dev` 的 .next 并存，不互相破坏
.next-build/
# 静态导出复验目录（README §14 的 NEXT_DIST_DIR=".next-verify"）
.next-verify/
.nuxt/
dist/

# Logs
*.log

# Database
*.sqlite3

# Local data (seed / dev snapshots)
data/
# ⚠️ 例外：`frontend/src/mocks/data/` **是源码**，必须被跟踪。
# 上面那条裸 `data/` 会匹配**任意层级**的 data 目录 ⇒ 该目录下**新增文件会被静默忽略**
# （`git status` 里都看不到，提交无声漏掉，别人机器上 import 崩）。
# `factory.ts` 之所以没事，只是因为它在这条规则之前就已被跟踪。
# 这里做**最小例外**（不放宽全局规则）：只重新纳入这一个目录。
# 实测：加这行前，`git check-ignore -v frontend/src/mocks/data/新文件.ts` 命中 `.gitignore:53:data/`，
# 且 `git status` 看不到它；加这行后不再被忽略。
!frontend/src/mocks/data/

# MinIO data (local dev)
minio_data/

# Frontend test artifacts
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/

# AI 辅助工具本地配置
.mcp.json
.mvn/
.claude/settings.local.json
.codex/

# 真实种子数据（本地开发使用，不提交）
backend/orchestrator/scripts/seed_data/*.yaml
backend/orchestrator/scripts/seed_data/*.json
!backend/orchestrator/scripts/seed_data/.gitignore
!backend/orchestrator/scripts/seed_data/README.md
# 核算脚本的产物（`scripts/verify/verify_against_sheet.py` 每次运行会重写）
backend/orchestrator/scripts/verify/sheet_niulanwang*.json

# 运行时日志
backend/orchestrator/logs/*.jsonl
backend/orchestrator/logs/*.log

# Frontend build artifacts
frontend/coverage/
frontend/.turbo/
frontend/out/

# Backend test artifacts
backend/orchestrator/.pytest_cache/
backend/orchestrator/htmlcov/
backend/orchestrator/.coverage*

# Legacy Qwen config (已迁移至 .ai/)
.qwen/

# Neon local config
.neon
.env.local
.agents/
skills-lock.json

# 多智能体协作状态（AgentTeams：团队/任务/信箱，属本机会话产物，不入库）
.agent-teams/

# 一次性临时脚本（约定：用完即删；绝不入库）
.tmp_*

# 临时脚本/构建产物（本地工具，不入库）
.tools/

# Playwright e2e generated auth state
frontend/e2e/.auth/

# 本地产物（非系统代码：PI 导出、QA 快照、一次性生成脚本、临时脚本等）
# 约定：这类东西一律放 artifacts/，不进 git；需要归档的成果走数据库或正式文档
/artifacts/

.tmp/
