# 拼多多客服工作台入口（登录后实际聊天页 URL，按你后台为准）
PDD_CHAT_URL=https://mms.pinduoduo.com/

# 消息路由
MSG_ROUTER_URL=http://localhost:8000
MSG_ROUTER_API_KEY=

# false = 有头（本地调试）；上云可改为 true
PLAYWRIGHT_HEADLESS=false

# 视口
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=800

# User-Agent（留空则使用 Playwright 默认 Chromium UA）
# BROWSER_USER_AGENT=

# 状态与 Cookie（相对 rpa-pdd 根目录）
STATE_DIR=data
COOKIES_PATH=data/cookies.json
SELECTORS_PATH=config/selectors.json

# 操作延迟（毫秒）
ACTION_DELAY_MS_MIN=200
ACTION_DELAY_MS_MAX=500
ACTION_MAX_RETRIES=3

# AI 请求超时（秒）
AI_HTTP_TIMEOUT_SEC=15.0
# true 时跳过 msg-router，直接返回固定回复（UI 联调）
AI_STUB_MODE=false
AI_STUB_REPLY=回复测试~

# DOM 轮询间隔（秒）
DOM_POLL_INTERVAL_SEC=2.0

# 截图目录
SCREENSHOT_DIR=screenshots
LOG_DIR=logs

# 登录检测：页面在多少秒内未出现 chat_ready_selector 则视为需登录/失败
LOGIN_NAV_TIMEOUT_MS=60000
# 控制台等待人工登录确认超时（秒）
LOGIN_CONSOLE_WAIT_TIMEOUT_SEC=300
